<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Propositions citoyennes</title>
</head>
<body>
    <h1>📜 Propositions citoyennes</h1>
    <ul>
        <% propositions.forEach(p => { %>
            <li><strong><%= p.titre %></strong> — <%= p.description %></li>
        <% }) %>
    </ul>

    <a href="<%= basePath %>/idees/nouvelle" class="btn">➕ Proposer une nouvelle idée</a>

</body>
</html>
