<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Idées citoyennes</title>
</head>
<body>
    <h1>🌱 Idées citoyennes</h1>
    <ul>
        <% idees.forEach(idee => { %>
            <li><strong><%= idee.titre %></strong> — <%= idee.description %></li>
        <% }) %>
    </ul>
</body>
</html>
