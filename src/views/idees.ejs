<!DOCTYPE html>
<html>
<head><title>Idées citoyennes</title></head>
<body>
  <h1>Idées par niveau</h1>
  <a href="<%= basePath %>/idees/nouvelle">➕ Nouvelle idée</a>

  <% ['Vision', 'Stratégie', 'Tactique', 'Action'].forEach(niveau => { %>
    <h2><%= niveau %></h2>
    <ul>
      <% idees.filter(i => i.niveau === niveau).forEach(i => { %>
        <li>
          <strong><%= i.titre %></strong> — <%= i.description %><br>
          Votes : ✅ <%= i.votes.pour %> ❌ <%= i.votes.contre %> 🤷 <%= i.votes.abstention %>
          <form method="POST" action="<%= basePath %>/idees/<%= i._id %>/vote">
            <button name="vote" value="pour">✅</button>
            <button name="vote" value="contre">❌</button>
            <button name="vote" value="abstention">🤷</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% }) %>
</body>
</html>
